{
  "sg_hfq_version": "0.1.0",
  "dataset": "StatLog (Landsat Satellite), official split 4435 train / 2000 test",
  "classes": {
    "1": "red soil",
    "2": "cotton crop",
    "3": "grey soil",
    "4": "damp grey soil",
    "5": "soil with vegetation stubble",
    "7": "very damp grey soil"
  },
  "representation": "bandmean4 (z-scored with training statistics)",
  "alpha": 0.5,
  "linkage": "average",
  "fuzzifier_m": 2.0,
  "fcm_tol": 1e-06,
  "fcm_max_iter": 1000,
  "n_grades_L": 5,
  "q_threshold": 2,
  "random_inits_E2": 10,
  "bootstrap_resamples": 1000,
  "seed": 0,
  "runtime_seconds": 46.1,
  "python": "3.11.15",
  "numpy": "2.4.6",
  "scipy": "1.17.1",
  "scikit_learn": "1.9.1",
  "pandas": "3.0.6",
  "matplotlib": "3.11.2"
}